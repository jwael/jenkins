import org.junit.jupiter.api.Assertions.assertTrue
import org.junit.jupiter.api.Test
import java.time.Instant

class ClockProviderTest {

    private val clockProvider = ClockProvider()

    @Test
    fun `now should return current instant`() {
        // WHEN
        val instantBeforeCall = Instant.now()
        val result = clockProvider.now()
        val instantAfterCall = Instant.now()

        // THEN
        assertTrue(result >= instantBeforeCall && result <= instantAfterCall,
            "Returned Instant should be between call start and call end")
    }
}